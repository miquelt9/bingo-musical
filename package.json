{
  "name": "bingo-musical",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:provider-model": "esbuild scripts/test-provider-model.ts --bundle --platform=node --format=esm --outfile=scripts/.test-provider-model.mjs && node scripts/.test-provider-model.mjs",
    "compute:sample-share-id": "esbuild scripts/compute-sample-share-id.ts --bundle --platform=node --format=esm --outfile=scripts/.compute-sample-share-id.mjs && node scripts/.compute-sample-share-id.mjs",
    "build": "npx tsc && npx vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@miquelt9/pc-ui": "github:miquelt9/pc-ui",
    "@zxing/browser": "^0.2.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/youtube": "^0.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.127.1"
  }
}
