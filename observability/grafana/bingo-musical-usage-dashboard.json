{
  "__inputs": [
    {
      "name": "DS_BINGO_MUSICAL_ANALYTICS",
      "label": "Bingo Musical Analytics Engine",
      "description": "Cloudflare Workers Analytics Engine through the Altinity ClickHouse data source",
      "type": "datasource",
      "pluginId": "vertamedia-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "vertamedia-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "3.4.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_BINGO_MUSICAL_ANALYTICS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT toDateTime(intDiv(toUInt32(timestamp), 3600) * 3600) AS time, concat(blob1, ' / ', if(blob3 = '', 'public', blob3)) AS metric, SUM(_sample_interval) AS value FROM bingo_musical_usage WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob1 IN ('share_opened', 'host_started', 'cards_printed') AND ('${audience}' = 'All' OR if(blob3 = '', 'public', blob3) = '${audience}') GROUP BY time, metric ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Product activity by audience",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_BINGO_MUSICAL_ANALYTICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT SUM(_sample_interval) AS value FROM bingo_musical_usage WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob1 = 'share_opened' AND ('${audience}' = 'All' OR if(blob3 = '', 'public', blob3) = '${audience}')",
          "refId": "A"
        }
      ],
      "title": "Shared decks displayed",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_BINGO_MUSICAL_ANALYTICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT SUM(_sample_interval) AS value FROM bingo_musical_usage WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob1 = 'host_started' AND ('${audience}' = 'All' OR if(blob3 = '', 'public', blob3) = '${audience}')",
          "refId": "A"
        }
      ],
      "title": "Host sessions started",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_BINGO_MUSICAL_ANALYTICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT SUM(_sample_interval) AS value FROM bingo_musical_usage WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob1 = 'cards_printed' AND ('${audience}' = 'All' OR if(blob3 = '', 'public', blob3) = '${audience}')",
          "refId": "A"
        }
      ],
      "title": "Bingo cards printed",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_BINGO_MUSICAL_ANALYTICS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT toDateTime(intDiv(toUInt32(timestamp), 3600) * 3600) AS time, if(blob4 = '', 'unknown', blob4) AS output, SUM(_sample_interval) AS value FROM bingo_musical_usage WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob1 = 'cards_printed' AND ('${audience}' = 'All' OR if(blob3 = '', 'public', blob3) = '${audience}') GROUP BY time, output ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Print output over time",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["bingo-musical", "cloudflare", "analytics-engine"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "All"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Audience",
        "multi": false,
        "name": "audience",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "All"
          },
          {
            "selected": false,
            "text": "tester",
            "value": "tester"
          },
          {
            "selected": false,
            "text": "public",
            "value": "public"
          }
        ],
        "query": "All,tester,public",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Bingo Musical Usage",
  "uid": "bingo-musical-usage",
  "version": 1
}
