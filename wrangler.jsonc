{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site for the bingo-musical Worker. The share API stays in worker/wrangler.toml.
  "name": "bingo-musical",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
