{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site for the bingo-musical Worker. The share API stays in worker/wrangler.toml.
  "name": "bingo-musical",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  // Workers Builds ignores this as its dashboard build step, but `versions upload` still runs it
  // and rewrites dist/ with the workers.dev root base before the assets are uploaded.
  "build": {
    "command": "npm run build:worker"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
